<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#101827">
    <meta name="description" content="A containerized web application built for the Cloud Deployment Lab.">
    <title>CloudLab | Deployment status</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <a class="brand" href="/" aria-label="CloudLab home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none"><path d="M8 22.5h16.5a5 5 0 0 0 .2-10A8.5 8.5 0 0 0 8.6 11a5.8 5.8 0 0 0-.6 11.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="m13 18 3-4 3 4m-3-3v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span>Cloud<span class="brand-light">Lab</span></span>
        </a>
        <div class="topbar-meta">
          <span class="online-dot" aria-hidden="true"></span>
          <span>Application online</span>
        </div>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-rule"></span> CLOUD DEPLOYMENT LAB</p>
            <h1 id="hero-title">Build once.<br><span>Deploy anywhere.</span></h1>
            <p class="hero-description">A lightweight web application, packaged for reliable delivery from a developer's machine to the cloud.</p>
          </div>
          <div class="deployment-stamp" aria-label="Deployment is healthy">
            <div class="stamp-ring">
              <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="m14 24 7 7 14-15" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <span class="stamp-label">DEPLOYMENT</span>
            <strong>Healthy</strong>
            <span class="stamp-caption">All systems ready</span>
          </div>
        </section>

        <section class="welcome-panel" aria-labelledby="welcome-title">
          <div class="welcome-accent" aria-hidden="true"></div>
          <div class="welcome-main">
            <p class="section-kicker">YOUR APPLICATION</p>
            <h2 id="welcome-title">Welcome to Cloud Deployment Lab!</h2>
            <p class="welcome-copy">This app demonstrates a simple path from source code to a live container on AWS EC2.</p>
          </div>
          <div class="details" aria-label="Application details">
            <div class="detail-item">
              <span class="detail-label">BUILT BY</span>
              <strong><%= name %></strong>
            </div>
            <div class="detail-divider" aria-hidden="true"></div>
            <div class="detail-item">
              <span class="detail-label">APP VERSION</span>
              <strong class="version-value"><span class="version-dot" aria-hidden="true"></span><%= version %></strong>
            </div>
          </div>
        </section>

        <section class="stack-section" aria-labelledby="stack-title">
          <div class="section-heading">
            <div>
              <p class="section-kicker">THE DELIVERY PATH</p>
              <h2 id="stack-title">Tools in the stack</h2>
            </div>
            <span class="stack-count">03 <span>TOOLS</span></span>
          </div>
          <div class="stack-grid">
            <article class="stack-item">
              <div class="stack-icon github-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.75-1.32-3.75-1.32-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.11.08 1.7 1.14 1.7 1.14.99 1.7 2.6 1.2 3.23.92.1-.72.39-1.2.71-1.47-2.47-.28-5.07-1.24-5.07-5.5 0-1.21.43-2.2 1.14-2.97-.11-.28-.5-1.42.11-2.94 0 0 .93-.3 3.05 1.13a10.6 10.6 0 0 1 5.55 0c2.12-1.43 3.04-1.13 3.04-1.13.61 1.52.23 2.66.12 2.94.71.77 1.13 1.76 1.13 2.98 0 4.27-2.6 5.21-5.08 5.49.4.34.76 1.02.76 2.06v3.07c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
              </div>
              <div class="stack-copy"><h3>GitHub</h3><p>Source control &amp; collaboration</p></div>
              <span class="stack-step">01</span>
            </article>
            <article class="stack-item">
              <div class="stack-icon docker-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 13.5h18.8c-.7 4.2-3.8 6.5-8.7 6.5h-2.1c-4.3 0-7.1-2.4-8-6.5ZM6 10h2.7v2.5H6zM9.5 10h2.7v2.5H9.5zM13 10h2.7v2.5H13zM9.5 6.5h2.7V9H9.5zM13 6.5h2.7V9H13zM16.5 10h2.7v2.5h-2.7zM21.3 11.5c.2-.8.1-1.6-.2-2.2 1-.1 1.8.2 2.4.8-.4.8-1.1 1.3-2.2 1.4Z"/></svg>
              </div>
              <div class="stack-copy"><h3>Docker</h3><p>Consistent container packaging</p></div>
              <span class="stack-step">02</span>
            </article>
            <article class="stack-item">
              <div class="stack-icon aws-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.8 20 7v9.5l-8 4.7-8-4.7V7l8-4.2Z"/><path d="m4.4 7.2 7.6 4.3 7.6-4.3M12 11.5v9.2M8.2 4.8l7.7 4.4"/></svg>
              </div>
              <div class="stack-copy"><h3>AWS EC2</h3><p>Cloud compute &amp; deployment</p></div>
              <span class="stack-step">03</span>
            </article>
          </div>
        </section>
      </main>

      <footer class="footer">
        <span>Cloud Deployment Lab <span class="footer-separator">/</span> <%= year %></span>
        <span class="footer-status"><span class="online-dot" aria-hidden="true"></span> Running smoothly</span>
      </footer>
    </div>
  </body>
</html>